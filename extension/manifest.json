{
  "manifest_version": 3,
  "name": "Prawdowid — sprawdź, zanim udostępnisz",
  "short_name": "Prawdowid",
  "version": "0.2.0",
  "description": "Pokazuje przy treściach oceny fact-checkerów dotyczące podobnych informacji — zawsze ze źródłem. Nie jest sędzią prawdy.",
  "default_locale": "pl",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prawdowid"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.trycloudflare.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "prawdowid@hackathon.local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
