# Required: set a private token for the moderator API. Do not use demo-moderator.
PRAWDOWID_MODERATOR_TOKEN=

# Local port; loopback by default. Use a reverse proxy for public HTTPS.
PRAWDOWID_BIND_ADDRESS=127.0.0.1
PRAWDOWID_PORT=8000
PRAWDOWID_PUBLIC_URL=http://localhost:8000

# Requests per minute and client address: full checks / extension batches (docs/DEPLOYMENT.md).
PRAWDOWID_RATE_LIMIT=120
PRAWDOWID_RATE_LIMIT_QUICK=60
# Behind a reverse proxy set the proxy address(es) here ("*" with the tls profile); otherwise all users share one limit.
# PRAWDOWID_TRUSTED_PROXY_IPS=127.0.0.1
PRAWDOWID_RETENTION_DAYS=30
PRAWDOWID_CPU_THREADS=4

# Optional TLS profile. Set this and PUBLIC_URL when deploying with a real domain.
PRAWDOWID_DOMAIN=localhost

# First start needs internet to download models; enable only after populating the model volume.
HF_HUB_OFFLINE=0
